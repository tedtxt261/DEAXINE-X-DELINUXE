#!/bin/bash

echo "🔥 Installing DElinuxe linux..."
sudo apt update
sudo apt install -y nodejs npm

mkdir DElinuxe-linux
cd DElinuxe-linux

npm init -y
npm install express node-fetch cors

cat << 'EOF' > server.js
import express from "express";
import fetch from "node-fetch";
import cors from "cors";

const app = express();
app.use(express.json());
app.use(cors());

app.post("/chat", async (req, res) => {
    try {
        const msg = req.body.message;

        const response = await fetch("https://api.openai.com/v1/chat/completions", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "Authorization": "Bearer YOUR_API_KEY"
            },
            body: JSON.stringify({
                model: "gpt-4.1-mini",
                messages: [{ role: "user", content: msg }]
            })
        });

        const data = await response.json();

        res.json({
            reply: data.choices?.[0]?.message?.content || "DEaxinE has no words 💀"
        });

    } catch (err) {
        res.json({ reply: "System error 💀 " + err.message });
    }
});

app.listen(3000, () => console.log("🚀 DEaxinE backend running on port 3000"));
EOF

sed -i 's/"main": "index.js"/"type": "module", "main": "index.js"/' package.json

node server.js
